# =============================================================================
# YADS Environment Configuration Template
# Copy to .env and fill in your values.
# =============================================================================

# =============================================================================
# CORE — Required for all deployments
# =============================================================================

# PostgreSQL password for the YADS database
POSTGRES_PASSWORD=change_me_strong_password

# JWT signing key — must be long and random (min. 32 chars)
SECRET_KEY=change_me_very_long_random_secret_key_here

# Setup wizard one-time token (auto-generated if empty)
# SETUP_TOKEN=

# =============================================================================
# AUTHENTICATION MODE
# "local" = built-in username/password (default, no Keycloak needed)
# "oidc"  = Single Sign-On via Keycloak or any OIDC-compatible IdP
# =============================================================================
AUTH_MODE=local

# =============================================================================
# OIDC / KEYCLOAK — only required if AUTH_MODE=oidc
#
# Option A: Use bundled Keycloak (docker compose --profile keycloak up -d)
#   OIDC_SERVER_URL = http://keycloak:8080   (Docker-internal)
#   OIDC_PUBLIC_URL = http://<your-host>:8080  (browser-accessible)
#
# Option B: External Keycloak instance
#   OIDC_SERVER_URL = https://keycloak.yourdomain.com  (reachable from YADS container)
#   OIDC_PUBLIC_URL = https://keycloak.yourdomain.com  (same, if publicly accessible)
#
# The split between SERVER_URL and PUBLIC_URL is needed when YADS runs inside
# Docker and Keycloak is only accessible via a different hostname from the container.
# =============================================================================
# OIDC_SERVER_URL=http://keycloak:8080
# OIDC_PUBLIC_URL=http://localhost:8080
# OIDC_REALM=yads
# OIDC_CLIENT_ID=yads
# OIDC_CLIENT_SECRET=changeme
# OIDC_REDIRECT_URI=http://localhost:8085/auth/oidc/callback

# =============================================================================
# BUNDLED KEYCLOAK — only if running with --profile keycloak
# =============================================================================
# KC_ADMIN=admin
# KC_ADMIN_PASSWORD=change_me
# KC_DB_PASSWORD=change_me
# KC_PORT=8080

# =============================================================================
# PROMETHEUS METRICS
# Set METRICS_ENABLED=true to expose /metrics endpoint for Prometheus scraping.
# Works with both bundled and external Prometheus/Grafana.
#
# METRICS_AUTH_MODE: "none" (open), "token" (Bearer token), "user" (HTTP basic)
# =============================================================================
METRICS_ENABLED=false
# METRICS_AUTH_MODE=token
# METRICS_TOKEN=change_me_metrics_token

# =============================================================================
# OBSERVABILITY STACK — only if running with --profile monitoring
# For external Grafana/Prometheus: set METRICS_ENABLED=true and configure
# your external Prometheus to scrape http://<yads-host>:<port>/metrics
# =============================================================================
# GRAFANA_ADMIN_PASSWORD=change_me
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100

# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.yourdomain.com:587
# GF_SMTP_FROM_ADDRESS=yads-alerts@yourdomain.com

# =============================================================================
# MINIO (Cold Storage / DORA EU 5-year log retention)
# Only needed with --profile monitoring.
# For external S3-compatible storage: configure Loki's storage backend separately.
# =============================================================================
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change_me
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# =============================================================================
# THREAT INTELLIGENCE API KEYS (optional, per-tenant configurable via UI)
# =============================================================================
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# OTX_API_KEY=

# =============================================================================
# TLS / CUSTOM CA (optional)
# =============================================================================
# DISABLE_HTTPS_ONLY=false
# CUSTOM_CA_CERT_PATH=/app/certs/ca-bundle.crt
# CLIENT_CERT_PATH=/app/certs/client.crt
# CLIENT_KEY_PATH=/app/certs/client.key
