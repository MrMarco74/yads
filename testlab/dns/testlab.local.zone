$ORIGIN testlab.local.
$TTL 300
@   IN  SOA  ns1.testlab.local. admin.testlab.local. (
        2024010101  ; serial
        3600        ; refresh
        900         ; retry
        604800      ; expire
        300         ; minimum TTL
)

@         IN  NS   ns1.testlab.local.
ns1       IN  A    172.30.0.10

; Core targets
dvwa      IN  A    172.30.0.20
juice     IN  A    172.30.0.21
badssl    IN  A    172.30.0.22
badheaders IN A   172.30.0.23
graphql   IN  A    172.30.0.24
ws        IN  A    172.30.0.25
gitexpose IN  A    172.30.0.26
loginpage IN  A    172.30.0.27
mockapis  IN  A    172.30.0.30
dsgvo     IN  A    172.30.0.40

; Mail (no SPF/DKIM/DMARC records intentionally)
mail      IN  A    172.30.0.28
@         IN  MX   10 mail.testlab.local.

; Subdomain takeover: CNAME points to a non-existent S3 bucket
staging   IN  CNAME   nonexistent-bucket-yads-test.s3.amazonaws.com.

; Wildcard for scanner subdomain enumeration
*         IN  A    172.30.0.23
