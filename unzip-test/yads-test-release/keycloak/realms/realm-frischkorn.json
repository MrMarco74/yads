{
  "realm": "frischkorn",
  "enabled": true,
  "displayName": "Frischkorn - YADS",
  "clients": [
    {
      "clientId": "yads",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "frischkorn-yads-secret",
      "redirectUris": ["http://localhost:8085/auth/oidc/callback"],
      "webOrigins": ["http://localhost:8085"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "yads-tenant-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "yads_tenant",
            "claim.value": "frischkorn",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "frischkorn-admins",
      "attributes": {
        "yads_role": ["tenant_admin"]
      }
    },
    {
      "name": "frischkorn-scanners",
      "attributes": {
        "yads_role": ["scanner"]
      }
    },
    {
      "name": "frischkorn-auditors",
      "attributes": {
        "yads_role": ["auditor"]
      }
    }
  ],
  "users": [
    {
      "username": "frischkorn-admin",
      "enabled": true,
      "email": "admin@frischkorn.local",
      "firstName": "Tenant",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "groups": ["frischkorn-admins"]
    },
    {
      "username": "frischkorn-scanner",
      "enabled": true,
      "email": "scanner@frischkorn.local",
      "firstName": "Scanner",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "scanner123",
          "temporary": false
        }
      ],
      "groups": ["frischkorn-scanners"]
    },
    {
      "username": "frischkorn-auditor",
      "enabled": true,
      "email": "auditor@frischkorn.local",
      "firstName": "Auditor",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "auditor123",
          "temporary": false
        }
      ],
      "groups": ["frischkorn-auditors"]
    }
  ]
}
