# ── YADS Worker (Production) ───────────────────────────────────────────────────
#
# Builds the Celery worker image on top of the pre-baked yads-tools image.
# Scanner tools (Playwright, Nuclei, Nmap) are already present in the base —
# only CSS build + Python deps + app code are layered on top.
#
# Build time: ~2-3 min (vs 15+ min for a full inline build).
# Requires: yads-tools image built and pushed to the registry.
#
# Build (Release Manager handles this automatically):
#   docker build -f Dockerfile.worker \
#     --build-arg TOOLS_IMAGE=gitlab.example.internal:5050/apps/yads/yads-tools:1.0 \
#     --build-arg YADS_GIT_SHA=$(git rev-parse --short HEAD) \
#     -t yads-worker:latest \
#     -t gitlab.example.internal:5050/apps/yads/yads-worker:latest \
#     .
#
# Nuclei templates are NOT baked in — provided via Docker volume at runtime:
#   volumes: - nuclei_templates:/root/nuclei-templates

# Global ARG — must be declared before first FROM to be usable in FROM instructions
ARG TOOLS_IMAGE=registry.yads-security.com/yads/yads-tools:1.0

# ── CSS Build (lightweight) ───────────────────────────────────────────────────
FROM node:18-alpine AS css-builder

WORKDIR /app
COPY frontend/package.json frontend/tailwind.config.js ./
COPY yads/api/templates ./yads/api/templates
COPY yads/api/static/css/input.css ./yads/api/static/css/input.css

RUN npm install
RUN npm run build:css


# ── Worker ────────────────────────────────────────────────────────────────────
FROM ${TOOLS_IMAGE} AS worker

ARG YADS_GIT_SHA
LABEL YADS_GIT_SHA=${YADS_GIT_SHA}

WORKDIR /app

# Python dependencies (cached layer — only invalidated when requirements.txt changes)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# CSS + Application code
COPY --from=css-builder /app/yads/api/static/css/main.css ./yads/api/static/css/main.css
COPY . .

CMD ["python", "scripts/start_worker.py"]
